SystemName REMAG FePt property convergence dzp_m400_k4_t300_z
SystemLabel remag
NumberOfAtoms 2
NumberOfSpecies 2
%block ChemicalSpeciesLabel
1 26 Fe_fept_SOC
2 78 Pt_fept_SOC
%endblock ChemicalSpeciesLabel
LatticeConstant 1.0 Ang
%block LatticeVectors
2.73 0.0 0.0
0.0 2.73 0.0
0.0 0.0 3.79
%endblock LatticeVectors
AtomicCoordinatesFormat NotScaledCartesianAng
%block AtomicCoordinatesAndAtomicSpecies
0.000000000000 0.000000000000 0.000000000000 1
1.365000000000 1.365000000000 1.895000000000 2
%endblock AtomicCoordinatesAndAtomicSpecies
%block kgrid_Monkhorst_Pack
4 0 0 0.0
0 4 0 0.0
0 0 4 0.0
%endblock kgrid_Monkhorst_Pack
Spin spin-orbit
%block DM.InitSpin
1 2.5 0.0 0.
2 0.3 0.0 0.
%endblock DM.InitSpin
PAO.BasisSize DZP
MeshCutoff 400 Ry
XC.functional GGA
XC.authors PBE
ElectronicTemperature 300 K
SolutionMethod diagon
Diag.Algorithm divide-and-conquer
MaxSCFIterations 300
SCF.MustConverge true
DM.Tolerance 1e-9
SCF.H.Tolerance 1e-8 eV
DM.MixingWeight 0.05
DM.NumberPulay 8
SCF.Mix.Spin all
DM.UseSaveDM false
WriteForces true
WriteMullikenPop 1
SaveRho true
SaveDeltaRho true
SaveHS true
UseTreeTimer true
UseParallelTimer false
UseWallTime true
Timing.Split.SCF.Steps false
Write.DM false
Write.DM.End.Of.Cycle true
TS.DE.Save false
CDF.Save false
Charge.Mulliken init+geometry+end
Charge.Mulliken.Format 1
Charge.Spin init+scf+geometry+end
PAO.EnergyShift 0.01 Ry
PAO.SplitNorm 0.15
WriteOrbMom true

SystemName REMAG regression fe2_relax
SystemLabel remag
NumberOfAtoms 2
NumberOfSpecies 1
%block ChemicalSpeciesLabel
1 26 Fe_nc
%endblock ChemicalSpeciesLabel
LatticeConstant 1.0 Ang
%block LatticeVectors
2.87 0.0 0.0
0.0 2.87 0.0
0.0 0.0 2.87
%endblock LatticeVectors
AtomicCoordinatesFormat NotScaledCartesianAng
%block AtomicCoordinatesAndAtomicSpecies
0.000000000000 0.000000000000 0.000000000000 1
1.475000000000 1.455000000000 1.435000000000 1
%endblock AtomicCoordinatesAndAtomicSpecies
%block kgrid_Monkhorst_Pack
3 0 0 0.0
0 3 0 0.0
0 0 3 0.0
%endblock kgrid_Monkhorst_Pack
Spin polarized
%block DM.InitSpin
1 2.5 0.0 0.
2 2.5 0.0 0.
%endblock DM.InitSpin
PAO.BasisSize SZP
MeshCutoff 100 Ry
XC.functional GGA
XC.authors PBE
ElectronicTemperature 300 K
SolutionMethod diagon
Diag.Algorithm divide-and-conquer
MaxSCFIterations 200
SCF.MustConverge true
DM.Tolerance 1e-06
SCF.H.Tolerance 1e-05 eV
DM.MixingWeight 0.05
DM.NumberPulay 6
SCF.Mix.Spin all
DM.UseSaveDM false
WriteForces true
WriteMullikenPop 1
SaveRho true
SaveDeltaRho true
SaveHS true
UseTreeTimer true
UseParallelTimer false
UseWallTime true
Timing.Split.SCF.Steps false
Write.DM false
Write.DM.End.Of.Cycle true
TS.DE.Save false
CDF.Save false
Charge.Mulliken init+geometry+end
Charge.Mulliken.Format 1
Charge.Spin init+scf+geometry+end
MD.TypeOfRun CG
MD.NumCGsteps 20
MD.MaxForceTol 0.01 eV/Ang

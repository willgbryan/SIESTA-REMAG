                      }
                    ],
                    "title": "Team Id"
                  },
                  "filename": {
                    "type": "string",
                    "title": "Filename",
                    "pattern": "(?i).+\\.cif$"
                  },
                  "upload_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Upload Id"
                  },
                  "visibility": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Visibility"
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Description"
                  }
                },
                "description": "A CIF, as Ouro resolves the ``structure`` input: a file asset, or an\nupload made for this run that never became one (``upload_id`` set, the\nasset fields null)."
              },
              "energy_cutoff": {
                "type": "number",
                "title": "Energy cutoff",
                "default": 0.5,
                "maximum": 2,
                "minimum": 0,
                "description": "With include_phase_diagram, the highest energy above the hull (eV/atom, 0.0-2.0) of the unstable phases shown in the plot"
              },
              "energy_surface": {
                "enum": [
                  "orb-v3-conservative-inf-mpa",
                  "pbe",
                  "prophet-oame-mbd"
                ],
                "type": "string",
                "title": "Energy surface",
                "default": "orb-v3-conservative-inf-mpa",
                "description": "Energies the hull is built from. orb-v3-conservative-inf-mpa: every reference scored with Orb v3 (MPA), the same model that scores your structure, so systematic model errors largely cancel. pbe: the Materials Project and Alexandria PBE/PBE+U energies, with your structure scored by Orb v3; covers every published phase, but model error does not cancel. prophet-oame-mbd: like Orb v3, every reference and your structure scored with Prophet OAME-MBD (Kairos Materials' Matbench Discovery checkpoint), on a GPU; a system's first Prophet hull scores its references and takes longer. All apply MP2020 corrections."
              },
              "allow_unrelaxed": {
                "type": "boolean",
                "title": "Allow unrelaxed input",
                "default": false,
                "description": "If false (default), reject inputs whose max force, on an atom or on the cell (stress \u00d7 volume per atom), exceeds 0.05 eV/\u00c5, so e_above_hull is for the uploaded CIF. If true, relax it first with the surface's model (Orb v3, or Prophet on the Prophet surface); the result then refers to the relaxed geometry, not the raw upload."
              },
              "include_generated_p1": {
                "type": "boolean",
                "title": "Include generated P1 structures",
                "default": false,
                "description": "Also put generated (GGen, Matra-Genoa) structures in space group P1 on the hull. Off by default: they are mostly symmetry-broken leftovers. Published P1 phases are always included."
              },
              "include_phase_diagram": {
                "type": "boolean",
                "title": "Include phase diagram",
                "default": false,
                "description": "Also save an interactive phase diagram of the chemical system as an Ouro file. Off by default: the energy above the hull, decomposition and formation energy are always in the response."
              },
              "include_user_materials": {
                "type": "boolean",
                "title": "Include user materials",
                "default": true,
                "description": "Include structures earlier submitted to Ouro in the hull. Only applies to MLIP surfaces."
              },
              "bypass_cif_health_screen": {
                "type": "boolean",
                "title": "Bypass CIF health screen",
                "default": false,
                "description": "Skip CIF validity checks (partial occupancies, overlapping atoms closer than 0.5 \u00c5). Use only when you have already validated the structure."
              }
            }
          }
        }
      },
      "required": true
    },

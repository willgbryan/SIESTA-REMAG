module m_remag_soc_export
  use iso_c_binding, only: c_int,c_double,c_double_complex,c_int64_t
  implicit none
  private
  public :: remag_write_soc,remag_capture_soc
  complex(c_double_complex),allocatable,target :: snapshot(:,:)
  real(c_double),allocatable :: saved_positions(:,:)
  real(c_double) :: saved_cell(3,3)
  integer,allocatable :: saved_num(:),saved_ptr(:),saved_list(:),saved_species(:)
  integer :: saved_rows=0,saved_columns=0,saved_capacity=0
  integer(c_int64_t) :: saved_epoch=0
  interface
    integer(c_int) function remag_nonlocal_h0_soc_export(rows,columns,capacity,num,ptr,list,off,epoch) bind(C)
      import c_int,c_double_complex,c_int64_t
      integer(c_int),value :: rows,columns,capacity
      integer(c_int),intent(in) :: num(*),ptr(*),list(*)
      complex(c_double_complex),intent(out) :: off(*)
      integer(c_int64_t),intent(out) :: epoch
    end function
    integer(c_int64_t) function remag_soc_geometry_epoch() bind(C)
      import c_int64_t
    end function
  end interface
contains
  subroutine clear_snapshot()
    if(allocated(snapshot))deallocate(snapshot,saved_positions,saved_num,saved_ptr,saved_list,saved_species)
    saved_epoch=0
  end subroutine
  subroutine remag_capture_soc(converged)
    use fdf, only: fdf_get
    use sys, only: die
    use parallel, only: Nodes
    use m_spin, only: spin
    use m_remag_nonlocal_force, only: remag_nonlocal_h0_enabled
    use sparse_matrices, only: maxnh,numh,listhptr,listh
    use atomlist, only: no_u,no_s
    use siesta_geom, only: na_u,xa,ucell,isa
    logical,intent(in) :: converged
    integer :: status
    if(.not.fdf_get('REMAG.WriteSOCMatrix',.false.))return
    if(remag_nonlocal_h0_enabled()/=1)return
    call clear_snapshot()
    if(Nodes/=1.or..not.spin%SO_offsite.or.spin%H/=8.or..not.converged) &
      call die('REMAG SOC snapshot requires converged serial off-site SOC')
    if(fdf_get('Read-H-from-file',.false.))call die('REMAG SOC snapshot cannot bind an externally supplied H')
    if(maxnh<=0.or.no_u<=0.or.no_s<no_u.or.na_u<=0)call die('REMAG SOC snapshot has invalid dimensions')
    allocate(snapshot(maxnh,4))
    saved_num=numh(1:no_u);saved_ptr=listhptr(1:no_u);saved_list=listh(1:maxnh)
    saved_species=isa(1:na_u);saved_positions=xa(1:3,1:na_u);saved_cell=ucell
    saved_rows=no_u;saved_columns=no_s;saved_capacity=maxnh
    status=remag_nonlocal_h0_soc_export(no_u,no_s,maxnh,numh,listhptr,listh,snapshot,saved_epoch)
    if(status/=0.or.saved_epoch<=0)call die('REMAG SOC snapshot device ownership/copy failed')
  end subroutine
  subroutine check_snapshot()
    use sys, only: die
    use sparse_matrices, only: maxnh,numh,listhptr,listh
    use atomlist, only: no_u,no_s
    use siesta_geom, only: na_u,xa,ucell,isa
    if(.not.allocated(snapshot))call die('REMAG SOC device snapshot is missing')
    if(saved_epoch/=remag_soc_geometry_epoch().or.saved_epoch<=0)call die('REMAG SOC snapshot epoch differs')
    if(saved_rows/=no_u.or.saved_columns/=no_s.or.saved_capacity/=maxnh)call die('REMAG SOC snapshot dimensions differ')
    if(size(saved_species)/=na_u)call die('REMAG SOC snapshot atom count differs')
    if(any(saved_num/=numh(1:no_u)).or.any(saved_ptr/=listhptr(1:no_u)).or.any(saved_list/=listh(1:maxnh))) &
      call die('REMAG SOC snapshot topology differs')
    if(any(saved_species/=isa(1:na_u)).or.any(saved_positions/=xa(1:3,1:na_u)).or.any(saved_cell/=ucell)) &
      call die('REMAG SOC snapshot geometry differs')
  end subroutine
  subroutine remag_write_soc()
    use precision, only: dp
    use fdf, only: fdf_get
    use parallel, only: Nodes
    use m_spin, only: spin
    use sparse_matrices, only: H_2D,S_1D,H_so_off_2D
    use class_dSpData2D, only: dSpData2D,newdSpData2D,val,spar,dist,delete
    use class_zSpData2D, only: val
    use io_hsx_m, only: write_hsx
    use kpoint_scf_m, only: kpoint_scf
    use atomlist, only: qtot
    use siesta_options, only: temp
    use m_energies, only: ef
    use files, only: slabel
    use sys, only: die
    use m_remag_nonlocal_force, only: remag_nonlocal_h0_enabled,remag_nonlocal_h0_poison_enabled
    use m_remag_soc_components, only: remag_soc_components
    type(dSpData2D) :: soc
    real(dp),pointer :: values(:,:)
    complex(dp),pointer :: off(:,:)
    integer :: status,unit
    logical :: device
    character(320) :: ownership
    if(.not.fdf_get('REMAG.WriteSOCMatrix',.false.))return
    if(Nodes/=1.or..not.spin%SO_offsite.or.spin%H/=8) &
      call die('REMAG SOC export requires serial off-site SOC')
    device=remag_nonlocal_h0_enabled()==1
    if(.not.device.and.remag_nonlocal_h0_poison_enabled()==1)call die('REMAG SOC poisoned host has no device owner')
    if(fdf_get('Read-H-from-file',.false.)) &
      call die('REMAG SOC export cannot bind an externally supplied H')
    if(device)then
      call check_snapshot()
      off=>snapshot
    else
      if(allocated(snapshot))call die('REMAG SOC owner changed after snapshot')
      off=>val(H_so_off_2D)
    endif
    if(.not.associated(off))call die('REMAG SOC export has no native nonlocal matrix')
    call newdSpData2D(spar(H_2D),8,dist(H_2D),soc,name='REMAG spin-dependent nonlocal operator')
    values=>val(soc)
    call remag_soc_components(off,values,status)
    if(status/=0)call die('REMAG SOC export has invalid native nonlocal components')
    call write_hsx(soc,S_1D,ef,qtot,temp,kpoint_scf,prec=dp,extension='SOC.HSX')
    call delete(soc)
    open(newunit=unit,file=trim(slabel)//'.SOC.json',status='replace',action='write',iostat=status)
    if(status/=0)call die('REMAG SOC metadata open failed')
    if(device)then
      write(ownership,'(a,i0,a,i0,a,i0,a,i0,a)') &
        '"snapshot_epoch":',saved_epoch,',"snapshot_rows":',saved_rows, &
        ',"snapshot_columns":',saved_columns,',"snapshot_capacity":',saved_capacity, &
        ',"snapshot_phase":"post_scf","snapshot_stage":"before_forces"}'
      write(unit,'(a)',iostat=status) &
        '{"format":"REMAG-NATIVE-SOC/2","operator":"spin-traceless-offsite-nonlocal",'// &
        '"producer":"remag-device-nonlocal-h0","host_nonlocal_h0":false,'// &
        '"spin_components":8,"unit":"Ry","encoding":"native-HSX-v2",'//trim(ownership)
    else
      write(unit,'(a)',iostat=status) &
      '{"format":"REMAG-NATIVE-SOC/1","operator":"spin-traceless-offsite-nonlocal",'// &
      '"producer":"pinned-setup_hamiltonian.F","host_nonlocal_h0":true,'// &
      '"spin_components":8,"unit":"Ry","encoding":"native-HSX-v2"}'
    endif
    if(status/=0)call die('REMAG SOC metadata write failed')
    close(unit,iostat=status)
    if(status/=0)call die('REMAG SOC metadata close failed')
    if(device)call clear_snapshot()
  end subroutine
end module
